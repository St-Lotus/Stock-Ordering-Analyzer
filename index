<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barcode Scanner App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Sized for 3in x 1.5in label */
        .label-preview {
            width: 3in;
            height: 1.5in;
            border: 1px solid #000;
            padding: 10px;
            position: relative;
            font-family: sans-serif;
        }
        .price-tag {
            background-color: yellow;
            position: absolute;
            bottom: 0;
            right: 0;
            padding: 5px 15px;
            font-weight: bold;
            font-size: 1.2rem;
        }
    </style>
</head>
<body class="bg-light p-5">

    <div class="container bg-white p-4 shadow-sm rounded">
        <h3>Barcode Lookup</h3>
        <!-- The input field the scanner will type into -->
        <input type="text" id="barcodeInput" class="form-control mb-4" placeholder="Scan Barcode here..." autofocus>

        <div id="resultArea" style="display:none;">
            <h5>Preview:</h5>
            <div class="label-preview">
                <div class="text-danger fw-bold">Star Mart</div>
                <div id="displayName" class="fw-bold">Product Name</div>
                <div id="displayCode">Code</div>
                <div class="price-tag">Ks. <span id="displayPrice">0</span></div>
            </div>
        </div>
    </div>

    <script>
        const barcodeInput = document.getElementById('barcodeInput');
        
        barcodeInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                const code = e.target.value;
                lookupProduct(code);
                e.target.value = ''; // Clear for next scan
            }
        });

        function lookupProduct(code) {
            // This logic will connect to your Google Sheet later
            console.log("Searching for: " + code);
            document.getElementById('resultArea').style.display = 'block';
            // Placeholder update
            document.getElementById('displayName').innerText = "Steel Colander 24cm";
            document.getElementById('displayPrice').innerText = "9,600";
        }
    </script>
</body>
</html>
